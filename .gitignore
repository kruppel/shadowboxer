# macOS
.DS_Store

# Agent plans (kept local)
.agents/

# Runtime state written through stow links
.vim/bundle/
.vim/_backup/*
!.vim/_backup/.gitkeep
.vim/_temp/*
!.vim/_temp/.gitkeep
.zsh/history

# Guard against runtime leakage into packages (e.g. tree folding on fresh machines)
claude/.claude/*
!claude/.claude/CLAUDE.md
codex/.codex/*
!codex/.codex/AGENTS.md
