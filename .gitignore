# macOS
.DS_Store

# Runtime state written through stow links
vim/.vim/bundle/
vim/.vim/_backup/*
!vim/.vim/_backup/.gitkeep
vim/.vim/_temp/*
!vim/.vim/_temp/.gitkeep
zsh/.zsh/history

# Guard against runtime leakage into packages (e.g. tree folding on fresh machines)
claude/.claude/*
!claude/.claude/CLAUDE.md
codex/.codex/*
!codex/.codex/AGENTS.md
config/.config/opencode/node_modules/
config/.config/opencode/package.json
config/.config/opencode/package-lock.json
config/.config/opencode/bun.lock
config/.config/opencode/.gitignore
