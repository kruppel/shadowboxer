#!/usr/bin/env bash

set -euo pipefail

DIRNAME=$(cd "$(dirname "$0")" && pwd)
PACKAGES=('agents' 'claude' 'codex' 'config' 'emacs' 'git' 'nvim' 'ruby' 'tmux' 'vim' 'zsh')

if ! command -v stow >/dev/null 2>&1; then
  echo "stow is required; install it separately, then rerun ./setup" >&2
  exit 1
fi

echo "Restowing dotfiles..."
if [ "$(uname -s)" = "Darwin" ]; then
  cat "$DIRNAME/.aliases/osx" "$DIRNAME/.aliases/shared" > "$HOME/.aliases"
else
  cat "$DIRNAME/.aliases/linux" "$DIRNAME/.aliases/shared" > "$HOME/.aliases"
fi

if [ -L "$HOME/.claude/CLAUDE.md" ] && [ "$(readlink "$HOME/.claude/CLAUDE.md")" = "$HOME/.agents/AGENTS.md" ]; then
  unlink "$HOME/.claude/CLAUDE.md"
fi
if [ -L "$HOME/.codex/AGENTS.md" ] && [ "$(readlink "$HOME/.codex/AGENTS.md")" = "$HOME/.claude/CLAUDE.md" ]; then
  unlink "$HOME/.codex/AGENTS.md"
fi

stow --dir="$DIRNAME" --target="$HOME" --restow "${PACKAGES[@]}"

OPENCODE_DIR="$HOME/.config/opencode"
for file in package.json package-lock.json; do
  target="$OPENCODE_DIR/$file"
  source="$DIRNAME/config/.config/opencode/$file"
  if [ -f "$target" ] && [ ! -L "$target" ]; then
    backup="$target.local"
    [ -e "$backup" ] && backup="$target.$(date +%Y%m%d%H%M%S).local"
    mv "$target" "$backup"
  fi
  ln -sfn "$source" "$target"
done
